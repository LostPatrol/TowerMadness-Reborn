        BEGIN
            VALUE "FileDescription", "TowerMadness Windows"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "TowerMadness"
            VALUE "ProductVersion", "Windows 1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
